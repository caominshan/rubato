# Select "qwen" for Alibaba Cloud Model Studio or "openai" for OpenAI.
MODEL_PROVIDER=qwen

# Qwen (recommended for the China-based prototype).
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI alternative. Server-side only; never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Applies to the OpenAI provider. Qwen always uses the app's local trace instead.
OPENAI_AGENTS_DISABLE_TRACING=0

# Local development metadata.
NEXT_PUBLIC_APP_NAME=Hey Tablo Agent
NEXT_PUBLIC_APP_STAGE=prototype
